{
  "name": "SalesPipeline",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:/REPLACE_WITH_REPO/powerbi/data\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "fct_opportunity",
        "columns": [
          {
            "name": "opportunity_id",
            "dataType": "string",
            "sourceColumn": "opportunity_id",
            "summarizeBy": "none"
          },
          {
            "name": "sales_agent_key",
            "dataType": "string",
            "sourceColumn": "sales_agent_key",
            "summarizeBy": "none"
          },
          {
            "name": "product_key",
            "dataType": "string",
            "sourceColumn": "product_key",
            "summarizeBy": "none"
          },
          {
            "name": "account_key",
            "dataType": "string",
            "sourceColumn": "account_key",
            "summarizeBy": "none"
          },
          {
            "name": "engage_date",
            "dataType": "dateTime",
            "sourceColumn": "engage_date",
            "summarizeBy": "none"
          },
          {
            "name": "close_date",
            "dataType": "dateTime",
            "sourceColumn": "close_date",
            "summarizeBy": "none"
          },
          {
            "name": "deal_stage",
            "dataType": "string",
            "sourceColumn": "deal_stage",
            "summarizeBy": "none"
          },
          {
            "name": "stage_order",
            "dataType": "int64",
            "sourceColumn": "stage_order",
            "summarizeBy": "none"
          },
          {
            "name": "is_won",
            "dataType": "boolean",
            "sourceColumn": "is_won",
            "summarizeBy": "none"
          },
          {
            "name": "is_lost",
            "dataType": "boolean",
            "sourceColumn": "is_lost",
            "summarizeBy": "none"
          },
          {
            "name": "is_closed",
            "dataType": "boolean",
            "sourceColumn": "is_closed",
            "summarizeBy": "none"
          },
          {
            "name": "is_open",
            "dataType": "boolean",
            "sourceColumn": "is_open",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "none"
          },
          {
            "name": "close_value_raw",
            "dataType": "double",
            "sourceColumn": "close_value_raw",
            "summarizeBy": "none"
          },
          {
            "name": "sales_cycle_days",
            "dataType": "int64",
            "sourceColumn": "sales_cycle_days",
            "summarizeBy": "none"
          },
          {
            "name": "snapshot_date",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_date",
            "summarizeBy": "none"
          },
          {
            "name": "days_open_at_snapshot",
            "dataType": "int64",
            "sourceColumn": "days_open_at_snapshot",
            "summarizeBy": "none"
          },
          {
            "name": "is_account_missing",
            "dataType": "boolean",
            "sourceColumn": "is_account_missing",
            "summarizeBy": "none"
          },
          {
            "name": "is_pre_engagement",
            "dataType": "boolean",
            "sourceColumn": "is_pre_engagement",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fct_opportunity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataFolder & \"/fct_opportunity.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                " Typed = Table.TransformColumnTypes(Nulls, {{\"opportunity_id\", type text}, {\"sales_agent_key\", type text}, {\"product_key\", type text}, {\"account_key\", type text}, {\"engage_date\", type date}, {\"close_date\", type date}, {\"deal_stage\", type text}, {\"stage_order\", Int64.Type}, {\"is_won\", type logical}, {\"is_lost\", type logical}, {\"is_closed\", type logical}, {\"is_open\", type logical}, {\"revenue\", type number}, {\"close_value_raw\", type number}, {\"sales_cycle_days\", Int64.Type}, {\"snapshot_date\", type date}, {\"days_open_at_snapshot\", Int64.Type}, {\"is_account_missing\", type logical}, {\"is_pre_engagement\", type logical}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Opportunities",
            "expression": "COUNTROWS(fct_opportunity)",
            "formatString": "#,0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Won Deals",
            "expression": "CALCULATE([Opportunities], KEEPFILTERS(fct_opportunity[deal_stage] = \"Won\"))",
            "formatString": "#,0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Closed Deals",
            "expression": "CALCULATE([Opportunities], KEEPFILTERS(fct_opportunity[deal_stage] IN {\"Won\", \"Lost\"}))",
            "formatString": "#,0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Won Revenue",
            "expression": "CALCULATE(SUM(fct_opportunity[revenue]), KEEPFILTERS(fct_opportunity[deal_stage] = \"Won\"))",
            "formatString": "$#,0;($#,0);$0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Win Rate",
            "expression": "DIVIDE([Won Deals], [Closed Deals])",
            "formatString": "0.0%",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Average Won Deal",
            "expression": "DIVIDE([Won Revenue], [Won Deals])",
            "formatString": "$#,0.00",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Average Won Sales Cycle Days",
            "expression": "CALCULATE(AVERAGE(fct_opportunity[sales_cycle_days]), KEEPFILTERS(fct_opportunity[deal_stage] = \"Won\"))",
            "formatString": "0.0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Open Opportunities",
            "expression": "CALCULATE([Opportunities], REMOVEFILTERS(dim_date), KEEPFILTERS(fct_opportunity[deal_stage] IN {\"Prospecting\", \"Engaging\"}))",
            "formatString": "#,0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Average Open Age Days",
            "expression": "CALCULATE(AVERAGE(fct_opportunity[days_open_at_snapshot]), REMOVEFILTERS(dim_date), KEEPFILTERS(fct_opportunity[deal_stage] IN {\"Prospecting\", \"Engaging\"}))",
            "formatString": "0.0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Missing Account Opportunities",
            "expression": "CALCULATE([Opportunities], KEEPFILTERS(fct_opportunity[is_account_missing] = TRUE()))",
            "formatString": "#,0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Missing Account Rate",
            "expression": "DIVIDE([Missing Account Opportunities], [Opportunities])",
            "formatString": "0.0%",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Revenue Previous Month",
            "expression": "CALCULATE([Won Revenue], DATEADD(dim_date[date_day], -1, MONTH))",
            "formatString": "$#,0",
            "displayFolder": "Sales KPIs"
          },
          {
            "name": "Revenue MoM Change",
            "expression": "VAR PreviousRevenue = [Revenue Previous Month] RETURN IF(NOT ISBLANK(PreviousRevenue), DIVIDE([Won Revenue] - PreviousRevenue, PreviousRevenue))",
            "formatString": "0.0%",
            "displayFolder": "Sales KPIs"
          }
        ]
      },
      {
        "name": "dim_sales_agent",
        "columns": [
          {
            "name": "sales_agent_key",
            "dataType": "string",
            "sourceColumn": "sales_agent_key",
            "summarizeBy": "none"
          },
          {
            "name": "agent_name",
            "dataType": "string",
            "sourceColumn": "agent_name",
            "summarizeBy": "none"
          },
          {
            "name": "manager_name",
            "dataType": "string",
            "sourceColumn": "manager_name",
            "summarizeBy": "none"
          },
          {
            "name": "manager_key",
            "dataType": "string",
            "sourceColumn": "manager_key",
            "summarizeBy": "none"
          },
          {
            "name": "regional_office",
            "dataType": "string",
            "sourceColumn": "regional_office",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_sales_agent",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataFolder & \"/dim_sales_agent.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                " Typed = Table.TransformColumnTypes(Nulls, {{\"sales_agent_key\", type text}, {\"agent_name\", type text}, {\"manager_name\", type text}, {\"manager_key\", type text}, {\"regional_office\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_product",
        "columns": [
          {
            "name": "product_key",
            "dataType": "string",
            "sourceColumn": "product_key",
            "summarizeBy": "none"
          },
          {
            "name": "product_name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "product_name_normalized",
            "dataType": "string",
            "sourceColumn": "product_name_normalized",
            "summarizeBy": "none"
          },
          {
            "name": "product_series",
            "dataType": "string",
            "sourceColumn": "product_series",
            "summarizeBy": "none"
          },
          {
            "name": "list_price",
            "dataType": "double",
            "sourceColumn": "list_price",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_product",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataFolder & \"/dim_product.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                " Typed = Table.TransformColumnTypes(Nulls, {{\"product_key\", type text}, {\"product_name\", type text}, {\"product_name_normalized\", type text}, {\"product_series\", type text}, {\"list_price\", type number}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_account",
        "columns": [
          {
            "name": "account_key",
            "dataType": "string",
            "sourceColumn": "account_key",
            "summarizeBy": "none"
          },
          {
