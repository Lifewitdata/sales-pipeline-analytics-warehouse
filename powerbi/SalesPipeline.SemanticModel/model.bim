            "sourceColumn": "iso_day_of_week",
            "summarizeBy": "none"
          },
          {
            "name": "day_of_year",
            "dataType": "int64",
            "sourceColumn": "day_of_year",
            "summarizeBy": "none"
          },
          {
            "name": "is_weekend",
            "dataType": "boolean",
            "sourceColumn": "is_weekend",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
