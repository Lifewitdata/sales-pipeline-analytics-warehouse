    ],
    "relationships": [
      {
        "name": "fact_to_dim_sales_agent",
        "fromTable": "fct_opportunity",
        "fromColumn": "sales_agent_key",
        "toTable": "dim_sales_agent",
        "toColumn": "sales_agent_key",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      },
      {
        "name": "fact_to_dim_product",
        "fromTable": "fct_opportunity",
        "fromColumn": "product_key",
        "toTable": "dim_product",
        "toColumn": "product_key",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      },
      {
        "name": "fact_to_dim_account",
        "fromTable": "fct_opportunity",
        "fromColumn": "account_key",
        "toTable": "dim_account",
        "toColumn": "account_key",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      },
      {
        "name": "fact_to_dim_date",
        "fromTable": "fct_opportunity",
        "fromColumn": "close_date",
        "toTable": "dim_date",
        "toColumn": "date_day",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      }
    ]
  }
}
