                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                " Typed = Table.TransformColumnTypes(Nulls, {{\"date_key\", Int64.Type}, {\"date_day\", type date}, {\"year\", Int64.Type}, {\"quarter\", Int64.Type}, {\"month_num\", Int64.Type}, {\"month_start\", type date}, {\"iso_week\", Int64.Type}, {\"iso_day_of_week\", Int64.Type}, {\"day_of_year\", Int64.Type}, {\"is_weekend\", type logical}}, \"en-US\")",
