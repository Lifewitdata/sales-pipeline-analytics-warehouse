            "sourceColumn": "office_country",
            "summarizeBy": "none"
          },
          {
            "name": "is_domestic",
            "dataType": "boolean",
            "sourceColumn": "is_domestic",
            "summarizeBy": "none"
          },
          {
            "name": "parent_account_name",
            "dataType": "string",
            "sourceColumn": "parent_account_name",
            "summarizeBy": "none"
          },
          {
            "name": "parent_account_key",
            "dataType": "string",
            "sourceColumn": "parent_account_key",
            "summarizeBy": "none"
          },
          {
            "name": "is_subsidiary",
            "dataType": "boolean",
            "sourceColumn": "is_subsidiary",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_account",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(DataFolder & \"/dim_account.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                " Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                " Typed = Table.TransformColumnTypes(Nulls, {{\"account_key\", type text}, {\"account_name\", type text}, {\"sector\", type text}, {\"year_established\", Int64.Type}, {\"annual_revenue\", type number}, {\"employee_count\", Int64.Type}, {\"office_country\", type text}, {\"is_domestic\", type logical}, {\"parent_account_name\", type text}, {\"parent_account_key\", type text}, {\"is_subsidiary\", type logical}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
